; ******** Source: bunnyblitz.asm
    14                          
    15                          ; BASIC loader stub
    16                          ; 6502 SYS 4109
    17                          *=$1001
    18  1001 0b10                   !word end_of_stub                   ; link to next line (end of BASIC stub)
    19  1003 6619                   !word 6502                          ; line number (can be anything, so why not)
    20  1005 9e                     !byte SYS                           ; SYS token
    21  1006 34313039               !text "4109"                        ; start of init code ($100D)
    22  100a 00                     !byte 0                             ; end of line
    23                          end_of_stub
    24  100b 0000                   !word 0                             ; end of BASIC stub
    25                          
    26                          ;===================================================================================================
    27                          ; Initialise once only
    28                          ;===================================================================================================
    29  100d a000                   ldy #0                              ; always leave Y as 0
    30  100f 8410                   sty SKIP_TITLE                      ; do not skip title the first time
    31                          
    32  1011 ad1891                 lda VIA1_TIMER2_LSB                 ; seed RND from the VIA timer
    33  1014 8507                   sta SEED_LSB
    34  1016 ad1991                 lda VIA1_TIMER2_MSB
    35  1019 8508                   sta SEED_MSB
    36                          
    37  101b b90080             -   lda CHAR_ROM_PAGE0,y                ; copy character ROM
    38  101e 99001c                 sta CHAR_RAM_PAGE0,y                ; into character RAM
    39  1021 b90081                 lda CHAR_ROM_PAGE1,y
    40  1024 99001d                 sta CHAR_RAM_PAGE1,y
    41  1027 c8                     iny
    42  1028 d0f1                   bne -
    43                          
    44  102a a200                   ldx #0                              ; copy user defined characters
    45  102c bd4c14             -   lda CharacterData,x
    46  102f 9d081d                 sta UDG_DATA,x                      ; into character RAM
    47  1032 e8                     inx
    48  1033 e030                   cpx #6 * 8                          ; 6 characters, 8 bytes per character
    49  1035 d0f5                   bne -
    50                          
    51  1037 a9ff                   lda #$FF                            ; character memory $1C00, screen $1E00
    52  1039 8d0590                 sta VIC_ADDRESSING
    53                          
    54                          ;===================================================================================================
    55                          ; Start / restart game
    56                          ;===================================================================================================
    57                          start:
    58                          
    59  103c a930                   lda #CHAR_0                         ; initialise stats variables
    60  103e 8520                   sta SCORE
    61  1040 8521                   sta BOMBS_UNITS
    62  1042 8522                   sta BOMBS_TENS
    63  1044 8523                   sta BUILDINGS_UNITS
    64  1046 8524                   sta BUILDINGS_TENS
    65  1048 8525                   sta BUILDINGS_HUNDREDS
    66                          
    67  104a a914                   lda #20                             ; set inital speed
    68  104c 8511                   sta PLANE_DELAY
    69                          
    70  104e a9fe                   lda #$FE                            ; reset bomb sound
    71  1050 8512                   sta BOMB_NOTE
    72                          
    73  1052 a90f                   lda #15                             ; maximum power!
    74  1054 8d0e90                 sta VIC_VOLUME
    75                          
    76  1057 a5c5               -   lda LAST_KEY                        ; wait for key release
    77  1059 c940                   cmp #KEY_NONE
    78  105b d0fa                   bne -
    79                          
    80  105d a510                   lda SKIP_TITLE                      ; skip the title if not the first time
    81  105f d005                   bne NEW_LEVEL
    82                          
    83  1061 204f13                 jsr SUB_TITLE                       ; show the title screen
    84  1064 e610                   inc SKIP_TITLE                      ; skip it next time
    85                          
    86                          ;===================================================================================================
    87                          ; Start a new level
    88                          ;===================================================================================================
    89                          NEW_LEVEL:
    90  1066 a91e                   lda #>SCREEN_RAM                    ; reset plane position
    91  1068 8531                   sta PLANE_MSB
    92  106a a996                   lda #>COLOUR_RAM
    93  106c 8533                   sta PLANE_COLOUR_MSB
    94  106e 8430                   sty PLANE_LSB
    95  1070 8432                   sty PLANE_COLOUR_LSB
    96                          
    97  1072 200714                 jsr SUB_CLS                         ; clear the screen
    98                          
    99  1075 a919                   lda #25                             ; white border and background
   100  1077 8d0f90                 sta VIC_BORDER
   101                          
   102  107a c611                   dec PLANE_DELAY                     ; increase the plane speed each level
   103                          
   104  107c a930                   lda #CHAR_0                         ; reset bombs count
   105  107e 8521                   sta BOMBS_UNITS
   106  1080 8522                   sta BOMBS_TENS
   107                          
   108                              ; draw the grass on the bottom three rows
   109  1082 a242                   ldx #3 * SCREEN_WIDTH
   110                          -
   111  1084 a924                   lda #UDG_GRASS                      ; grass is apparently just a solid square
   112  1086 9db81f                 sta GROUND_POS,x
   113  1089 a905                   lda #COLOUR_GREEN                   ; at least it is green
   114  108b 9db897                 sta GROUND_COLOUR,x
   115  108e ca                     dex
   116  108f 10f3                   bpl -
   117                          
   118                              ; setup stats display
   119  1091 a921                   lda #UDG_BUIDLING
   120  1093 8dd01f                 sta SCREEN_TB_LOGO
   121                          
   122  1096 a923                   lda #UDG_BOMB
   123  1098 8dd81f                 sta SCREEN_B_LOGO
   124                          
   125  109b a922                   lda #UDG_PLANE
   126  109d 8ddf1f                 sta SCREEN_SC_LOGO
   127                          
   128  10a0 a920                   lda #CHAR_SPACE
   129  10a2 8dd11f                 sta SCREEN_TB_LOGO+1
   130  10a5 8dd91f                 sta SCREEN_B_LOGO+1
   131  10a8 8de01f                 sta SCREEN_SC_LOGO+1
   132                          
   133  10ab a930                   lda #CHAR_0
   134  10ad 8dd21f                 sta SCREEN_TB_HUNDREDS
   135  10b0 8dd31f                 sta SCREEN_TB_TENS
   136  10b3 8dd41f                 sta SCREEN_TB_UNITS
   137  10b6 8dda1f                 sta SCREEN_B_TENS
   138  10b9 8ddb1f                 sta SCREEN_B_UNITS
   139  10bc 8de11f                 sta SCREEN_SC_UNITS
   140                          
   141  10bf a902                   lda #COLOUR_RED
   142  10c1 8dd897                 sta SCREEN_B_LOGO + COLOUR_RAM_OFFSET
   143                          
   144  10c4 a906                   lda #COLOUR_BLUE
   145  10c6 8ddf97                 sta SCREEN_SC_LOGO + COLOUR_RAM_OFFSET
   146                          
   147  10c9 a900                   lda #COLOUR_BLACK
   148  10cb 8dd097                 sta SCREEN_TB_LOGO + COLOUR_RAM_OFFSET
   149  10ce 8dd297                 sta SCREEN_TB_HUNDREDS + COLOUR_RAM_OFFSET
   150  10d1 8dd397                 sta SCREEN_TB_TENS + COLOUR_RAM_OFFSET
   151  10d4 8dd497                 sta SCREEN_TB_UNITS + COLOUR_RAM_OFFSET
   152  10d7 8dda97                 sta SCREEN_B_TENS + COLOUR_RAM_OFFSET
   153  10da 8ddb97                 sta SCREEN_B_UNITS + COLOUR_RAM_OFFSET
   154  10dd 8de197                 sta SCREEN_SC_UNITS + COLOUR_RAM_OFFSET
   155                          
   156                              ; add the buildings
   157  10e0 8413                   sty COL                             ; start in column 0
   158  10e2 8426                   sty BUILDINGS_STANDING              ; no buildings so far
   159                          
   160                          buildloop:
   161                          
   162                              ; get random number from 0-5
   163  10e4 203814             -   jsr RAND16                          ; get random number
   164  10e7 2907                   and #7                              ; mask to 0-7
   165  10e9 c906                   cmp #6                              ; repeat if 6 or 7
   166  10eb b0f7                   bcs -
   167                              
   168  10ed c904                   cmp #4                              ; check value, >= 4?
   169  10ef b029                   bcs nextcol                         ; skip building
   170                          
   171  10f1 e626                   inc BUILDINGS_STANDING              ; we have a new building
   172                          
   173  10f3 aa                     tax                                 ; X = number of storeys
   174                          
   175  10f4 a513                   lda COL                             ; offset starts as column
   176                          
   177  10f6 e8                     inx                                 ; 0-3 -> 1-4
   178  10f7 18                     clc
   179                          offsetloop:
   180  10f8 692c                   adc #2 * SCREEN_WIDTH               ; add 2 lines at a time
   181  10fa ca                     dex
   182  10fb d0fb                   bne offsetloop
   183                          
   184  10fd aa                     tax                                 ; X = offset
   185  10fe a926                   lda #UDG_ROOF                       ; draw the roof
   186  1100 9dc61e                 sta SKYLINE,x                       ;
   187  1103 98                     tya                                 ; set the roof colour to black (0)
   188  1104 9dc696                 sta SKYLINE_COL,x                   ;
   189                          
   190  1107 18                     clc
   191                          drawloop:
   192  1108 8a                     txa                                 ; X = X + 22
   193  1109 6916                   adc #SCREEN_WIDTH                   ;
   194  110b aa                     tax                                 ;
   195                          
   196  110c a921                   lda #UDG_BUIDLING                   ; draw the building
   197  110e 9dc61e                 sta SKYLINE,x                       ;
   198  1111 a900                   lda #COLOUR_BLACK                   ; set the building colour
   199  1113 9dc696                 sta SKYLINE_COL,x                   ;
   200  1116 e0dc                   cpx #BUILDING_MAX_HEIGHT            ; reached the limit?
   201  1118 90ee                   bcc drawloop
   202                          
   203                          nextcol:
   204  111a e613                   inc COL                             ; move to the next column
   205  111c a513                   lda COL                             ; check < 22 columns
   206  111e c916                   cmp #SCREEN_WIDTH
   207  1120 d0c2                   bne buildloop
   208                          
   209                              ; drop through
   210                          
   211                          ;======================================================================================
   212                          ; The main game loop
   213                          ;======================================================================================
   214                          MAIN_LOOP:
   215                              ; draw the plane
   216  1122 a922                   lda #UDG_PLANE
   217  1124 9130                   sta (PLANE),y
   218  1126 a906                   lda #COLOUR_BLUE
   219  1128 9132                   sta (PLANE_COLOUR),y
   220                          
   221                              ; plane flight delay
   222  112a a511                   lda PLANE_DELAY
   223  112c 202e14                 jsr DELAY
   224                          
   225                              ; print stats
   226  112f a521                   lda BOMBS_UNITS
   227  1131 8ddb1f                 sta SCREEN_B_UNITS
   228  1134 a522                   lda BOMBS_TENS
   229  1136 8dda1f                 sta SCREEN_B_TENS
   230                          
   231  1139 a525                   lda BUILDINGS_HUNDREDS
   232  113b 8dd21f                 sta SCREEN_TB_HUNDREDS
   233  113e a524                   lda BUILDINGS_TENS
   234  1140 8dd31f                 sta SCREEN_TB_TENS
   235  1143 a523                   lda BUILDINGS_UNITS
   236  1145 8dd41f                 sta SCREEN_TB_UNITS
   237                          
   238  1148 a520                   lda SCORE
   239  114a 8de11f                 sta SCREEN_SC_UNITS
   240                          
   241  114d a5c5               -   lda LAST_KEY                        ; check last key pressed
   242  114f c920                   cmp #KEY_SPACE                      ; was it SPACE ?
   243  1151 d003                   bne +
   244  1153 201812                 JSR DROP_BOMB                       ; yes, drop a bomb
   245                          
   246  1156 c8                 +   iny                                 ; no, check if we hit anything
   247  1157 b130                   lda (PLANE),y                       ; Y=1, check next character
   248  1159 88                     dey                                 ; Y back to zero, phew
   249  115a c926                   cmp #UDG_ROOF                       ; was it a bit of building?
   250  115c f073                   beq CRASHED                         ; yes
   251  115e c921                   cmp #UDG_BUIDLING
   252  1160 f06f                   beq CRASHED                         ; also yes
   253                          
   254  1162 a016                   ldy #SCREEN_WIDTH                   ; no, so check below for ground
   255  1164 b130                   lda (PLANE),y
   256  1166 a000                   ldy #0
   257  1168 c924                   cmp #UDG_GRASS                      ; have we landed?
   258  116a f02a                   beq TAXI_HOME                       ; yes
   259                          
   260                              ; not landed yet
   261                          
   262                              ; the ↑ key is pause - who knew?
   263  116c a5c5                   lda LAST_KEY
   264  116e c936                   cmp #KEY_UP_ARROW
   265  1170 d003                   bne +
   266  1172 203113                 jsr SUB_PAUSE
   267                          
   268  1175 a925               +   lda #UDG_SKY                        ; hide the old plane position
   269  1177 9130                   sta (PLANE),y
   270                          
   271  1179 a901                   lda #1                              ; move 1 square to the right
   272  117b a626                   ldx BUILDINGS_STANDING              ; check if all the buildings are gone?
   273  117d d002                   bne +
   274  117f a917                   lda #SCREEN_WIDTH + 1               ; yes, start to descend, 1 right, 1 down
   275                          
   276  1181 18                 +   clc                                 ; add 1 or 23 to the plane position
   277  1182 6530                   adc PLANE_LSB
   278  1184 8530                   sta PLANE_LSB                       ; update postition and colour
   279  1186 8532                   sta PLANE_COLOUR_LSB
   280  1188 9004                   bcc +
   281  118a e631                   inc PLANE_MSB
   282  118c e633                   inc PLANE_COLOUR_MSB
   283                          
   284  118e a9f5               +   lda #$F5                            ; make the noise
   285  1190 8d0d90                 sta VIC_NOISE_FREQ
   286                          
   287  1193 4c2211                 jmp MAIN_LOOP                       ; and repeat until we hit something or land
   288                          
   289                          
   290                          ;======================================================================================
   291                          ; Taxi the plane to the right hand edge
   292                          ;======================================================================================
   293                          TAXI_HOME:
   294  1196 8c0d90                 sty VIC_NOISE_FREQ                  ; kill the noise
   295  1199 8c0a90                 sty VIC_OSC1_FREQ                   ; sound off
   296                          
   297                          -
   298  119c a922                   lda #UDG_PLANE                      ; draw the plane
   299  119e 9130                   sta (PLANE),y
   300  11a0 a906                   lda #COLOUR_BLUE
   301  11a2 9132                   sta (PLANE_COLOUR),y
   302                          
   303  11a4 a932                   lda #50                             ; taxing slowly
   304  11a6 202e14                 jsr DELAY
   305                          
   306  11a9 a925                   lda #UDG_SKY                        ; hide the old plane position
   307  11ab 9130                   sta (PLANE),y
   308                          
   309  11ad e630                   inc PLANE_LSB                       ; move along one square
   310  11af e632                   inc PLANE_COLOUR_LSB
   311  11b1 d004                   bne +
   312  11b3 e631                   inc PLANE_MSB
   313  11b5 e633                   inc PLANE_COLOUR_MSB
   314                          
   315  11b7 a531               +   lda PLANE_MSB                       ; has the plane reached the far right edge?
   316  11b9 c91f                   cmp #>GROUND_POS                    ;
   317  11bb d004                   bne +                               ; different, so no need to check LSB
   318  11bd a530                   lda PLANE_LSB                       ; compare LSB instead
   319  11bf c9b8                   cmp #<GROUND_POS                    ;
   320  11c1 90d9               +   bcc -                               ; no keep looping
   321                          
   322                              ; Plane has landed safely
   323  11c3 e620                   inc SCORE                           ; increase score
   324                          
   325  11c5 a520                   lda SCORE                           ; has the user scored 10 landings?
   326  11c7 c93a                   cmp #CHAR_10
   327  11c9 d003                   bne +
   328  11cb 4cef12                 jmp LANDED_10                       ; yes, celebrate
   329                          +
   330  11ce 4c6610                 jmp NEW_LEVEL                       ; start the next level
   331                          
   332                          
   333                          ;======================================================================================
   334                          ; oh, now we hit someone, Mrs Webb
   335                          ;======================================================================================
   336                          CRASHED:
   337  11d1 a996                   lda #$96
   338  11d3 8d0d90                 sta VIC_NOISE_FREQ
   339                          
   340                              ; shake the screen 10 times
   341  11d6 a90a                   lda #10
   342  11d8 8502                   sta TEMP
   343                          
   344  11da a932               -   lda #50
   345  11dc 8d0190                 sta VIC_VERTICAL_CENTRE
   346                          
   347  11df a919                   lda #25                             ; delay for 25
   348  11e1 202e14                 jsr DELAY
   349                          
   350  11e4 a91e                   lda #30
   351  11e6 8d0190                 sta VIC_VERTICAL_CENTRE
   352                          
   353  11e9 a919                   lda #25                             ; delay for 25
   354  11eb 202e14                 jsr DELAY
   355                          
   356  11ee c602                   dec TEMP
   357  11f0 d0e8                   bne -
   358                          
   359  11f2 ade5ed                 lda KERNAL_VIC_REGS_VC              ; restore the original value of vertical centering
   360  11f5 8d0190                 sta VIC_VERTICAL_CENTRE
   361                          
   362                              ; flash the border
   363  11f8 8402                   sty TEMP
   364                          
   365  11fa a502               -   lda TEMP
   366  11fc 8d0f90                 sta VIC_BORDER
   367                          
   368  11ff a932                   lda #50
   369  1201 202e14                 jsr DELAY
   370  1204 a932                   lda #50
   371  1206 202e14                 jsr DELAY
   372                          
   373  1209 a502                   lda TEMP
   374  120b 18                     clc
   375  120c 6916                   adc #22
   376  120e 8502                   sta TEMP
   377  1210 90e8                   bcc -
   378                          
   379  1212 8c0d90                 sty VIC_NOISE_FREQ                  ; stop the noise
   380                          
   381  1215 4cd712                 jmp YOU_CRASHED
   382                          
   383                          ;======================================================================================
   384                          ; Drop a bomb
   385                          ;======================================================================================
   386                          DROP_BOMB:
   387  1218 a522                   lda BOMBS_TENS                      ; check bomb count
   388  121a c933                   cmp #CHAR_3                         ; max is 30
   389  121c 9001                   bcc +
   390  121e 60                     rts                                 ; max bombs used, do nothing
   391                          
   392                              ; drop the bomb
   393  121f a530               +   lda PLANE_LSB                       ; bomb starts at plane position
   394  1221 8534                   sta BOMB_LSB
   395  1223 8536                   sta BOMB_COLOUR_LSB
   396                          
   397  1225 a531                   lda PLANE_MSB
   398  1227 8535                   sta BOMB_MSB
   399  1229 a533                   lda PLANE_COLOUR_MSB
   400  122b 8537                   sta BOMB_COLOUR_MSB
   401                          
   402                          bombloop:
   403  122d a923                   lda #UDG_BOMB                       ; draw the bomb
   404  122f 9134                   sta (BOMB),y
   405  1231 a902                   lda #COLOUR_RED                     ; colour the bomb
   406  1233 9136                   sta (BOMB_COLOUR),y                
   407  1235 a512                   lda BOMB_NOTE
   408  1237 8d0a90                 sta VIC_OSC1_FREQ                   ; bomb in flight
   409                          
   410  123a a90a                   lda #10                             ; delay for 10
   411  123c 202e14                 jsr DELAY
   412                          
   413  123f a925                   lda #UDG_SKY                        ; hide the bomb
   414  1241 9134                   sta (BOMB),y
   415                          
   416  1243 c612                   dec BOMB_NOTE                       ; change the bomb note
   417  1245 c612                   dec BOMB_NOTE
   418                          
   419  1247 a016                   ldy #SCREEN_WIDTH                   ; check the line below
   420  1249 b134                   lda (BOMB),y
   421  124b aa                     tax
   422  124c c921                   cmp #UDG_BUIDLING                   ; is it a building?
   423  124e d024                   bne +
   424  1250 a02c                   ldy #SCREEN_WIDTH*2                 ; check 2 lines below
   425  1252 b134                   lda (BOMB),y
   426  1254 c924                   cmp #UDG_GRASS                      ; grass below?
   427  1256 d01c                   bne +
   428                          
   429  1258 c626                   dec BUILDINGS_STANDING              ; reduce the count of buildings
   430  125a e623                   inc BUILDINGS_UNITS                 ; increase count of toppled buildings
   431  125c a523                   lda BUILDINGS_UNITS                 ; check for rollovers
   432  125e c93a                   cmp #CHAR_10
   433  1260 d012                   bne +
   434  1262 a930                   lda #CHAR_0                         ; 10, so units to 0 and increment 10s
   435  1264 8523                   sta BUILDINGS_UNITS
   436  1266 e624                   inc BUILDINGS_TENS
   437  1268 a524                   lda BUILDINGS_TENS                  ; check for rollovers
   438  126a c93a                   cmp #CHAR_10
   439  126c d006                   bne +
   440  126e a930                   lda #CHAR_0                         ; 100 so tens to 0 and increment 100s
   441  1270 8524                   sta BUILDINGS_TENS
   442  1272 e625                   inc BUILDINGS_HUNDREDS              ; no I am not checking for 1000.
   443                          
   444  1274 a000               +   ldy #0                              ; restore order to the universe
   445  1276 e026                   cpx #UDG_ROOF                       ; is there a roof below us?
   446  1278 d005                   bne +
   447  127a a982                   lda #$82                            ; make the crunching noise
   448  127c 8d0d90                 sta VIC_NOISE_FREQ
   449                          
   450  127f a534               +   lda BOMB_LSB                        ; move bomb down 1 line
   451  1281 18                     clc
   452  1282 6916                   adc #SCREEN_WIDTH
   453  1284 8534                   sta BOMB_LSB
   454  1286 8536                   sta BOMB_COLOUR_LSB
   455  1288 9004                   bcc +
   456  128a e635                   inc BOMB_MSB
   457  128c e637                   inc BOMB_COLOUR_MSB
   458                          
   459  128e a535               +   lda BOMB_MSB                        ; check if it is at ground level
   460  1290 c91f                   cmp #>GROUND_POS                    ;
   461  1292 d004                   bne +                               ; different, so no need to check LSB
   462  1294 a534                   lda BOMB_LSB                        ; compare LSB instead
   463  1296 c9b8                   cmp #<GROUND_POS                    ;
   464  1298 9093               +   bcc bombloop                        ; no, keep moving down
   465                          
   466                              ; bomb landed
   467                              ; get a random number from 0-2
   468  129a 203814             -   jsr RAND16                          ; get a random number
   469  129d 2903                   and #3                              ; mask to 0-3
   470  129f c902                   cmp #2                              ; repeat if 3
   471  12a1 b0f7                   bcs -
   472                              
   473  12a3 18                     clc                                 ; move plane by that amount
   474  12a4 6530                   adc PLANE_LSB
   475  12a6 8530                   sta PLANE_LSB
   476  12a8 8532                   sta PLANE_COLOUR_LSB
   477  12aa 9004                   bcc +
   478  12ac e631                   inc PLANE_MSB
   479  12ae e633                   inc PLANE_COLOUR_MSB
   480                          +
   481                          
   482  12b0 e621                   inc BOMBS_UNITS                     ; bombs used count++
   483  12b2 a521                   lda BOMBS_UNITS                     ; check for rollovers
   484  12b4 c93a                   cmp #CHAR_10
   485  12b6 d014                   bne +
   486  12b8 a930                   lda #CHAR_0                         ; 10, so units to 0 and increment 10s
   487  12ba 8521                   sta BOMBS_UNITS
   488  12bc e622                   inc BOMBS_TENS                      ; max is 30, so no rollover to check
   489  12be a522                   lda BOMBS_TENS                      ; check bomb count
   490  12c0 c933                   cmp #CHAR_3                         ; max is 30
   491  12c2 9008                   bcc +
   492  12c4 a902                   lda #COLOUR_RED                     ; max bombs used, set the display red
   493  12c6 8dda97                 sta SCREEN_B_TENS + COLOUR_RAM_OFFSET
   494  12c9 8ddb97                 sta SCREEN_B_UNITS + COLOUR_RAM_OFFSET
   495                          
   496  12cc a9fe               +   lda #$FE                            ; reset bomb note
   497  12ce 8512                   sta BOMB_NOTE
   498                          
   499  12d0 8c0a90                 sty VIC_OSC1_FREQ                   ; sound off
   500  12d3 8c0d90                 sty VIC_NOISE_FREQ                  ; noise off
   501                          
   502  12d6 60                     rts
   503                          
   504                          ;======================================================================================
   505                          ; Tell the pilot how bad they really are
   506                          ;======================================================================================
   507                          YOU_CRASHED:
   508  12d7 209e13                 jsr SUB_START_TEXT_SCREEN
   509                          
   510  12da a915                   lda #>TEXT_CRASHED
   511  12dc 8539                   sta TEXT_MSB
   512  12de a972                   lda #<TEXT_CRASHED
   513  12e0 8538                   sta TEXT_LSB
   514                          
   515  12e2 a91e                   lda #>SCREEN_RAM_LINE_00
   516  12e4 a200                   ldx #<SCREEN_RAM_LINE_00
   517  12e6 201e14                 jsr SUB_PRINT_STRING
   518                          
   519  12e9 20b113                 jsr SUB_SHOW_STATS
   520                          
   521  12ec 4c0e13                 jmp ANOTHER_GO
   522                          
   523                          ;======================================================================================
   524                          ; 10 landings, well done
   525                          ;======================================================================================
   526                          LANDED_10:
   527  12ef 209e13                 jsr SUB_START_TEXT_SCREEN
   528                          
   529  12f2 a916                   lda #>TEXT_LANDED
   530  12f4 8539                   sta TEXT_MSB
   531  12f6 a90d                   lda #<TEXT_LANDED
   532  12f8 8538                   sta TEXT_LSB
   533                          
   534  12fa a91e                   lda #>SCREEN_RAM_LINE_00
   535  12fc a200                   ldx #<SCREEN_RAM_LINE_00
   536  12fe 201e14                 jsr SUB_PRINT_STRING
   537                          
   538  1301 20b113                 jsr SUB_SHOW_STATS
   539                          
   540                              ; fix the score
   541  1304 a931                   lda #CHAR_1
   542  1306 8dc81e                 sta SCREEN_RAM_LINE_09 + 2
   543  1309 a930                   lda #CHAR_0
   544  130b 8dc91e                 sta SCREEN_RAM_LINE_09 + 3
   545                          
   546                              ; drop through
   547                          
   548                          ;======================================================================================
   549                          ; Another go, start or go to READY prompt
   550                          ;======================================================================================
   551                          ANOTHER_GO:
   552                              ; another go?
   553  130e a914                   lda #>TEXT_ANOTHER_GO
   554  1310 8539                   sta TEXT_MSB
   555  1312 a9cc                   lda #<TEXT_ANOTHER_GO
   556  1314 8538                   sta TEXT_LSB
   557                          
   558  1316 a91f                   lda #>SCREEN_RAM_LINE_20 + 2
   559  1318 a2ba                   ldx #<SCREEN_RAM_LINE_20 + 2
   560  131a 201e14                 jsr SUB_PRINT_STRING
   561                          
   562  131d a5c5               -   lda LAST_KEY                        ; wait for key press
   563  131f c940                   cmp #KEY_NONE
   564  1321 f0fa                   beq -
   565                          
   566  1323 c90b                   cmp #KEY_Y                          ; was it Y ?
   567  1325 f007                   beq RESTART
   568                          
   569  1327 c91c                   cmp #KEY_N                          ; was it N?
   570  1329 d0f2                   bne -                               ; no, keep checking
   571                          
   572  132b 4c22fd                 jmp KERNAL_START                    ; N = reset VIC to READY prompt
   573                          
   574                          RESTART:
   575  132e 4c3c10                 jmp start                           ; Y = start again
   576                          
   577                          
   578                          ;======================================================================================
   579                          ; Pause
   580                          ;======================================================================================
   581                          SUB_PAUSE:
   582  1331 8c0d90                 sty VIC_NOISE_FREQ                  ; kill the noise
   583  1334 8c0a90                 sty VIC_OSC1_FREQ                   ;
   584                          
   585  1337 a5c5               -   lda LAST_KEY                        ; wait for key release
   586  1339 c940                   cmp #KEY_NONE
   587  133b d0fa                   bne -
   588                          
   589  133d a5c5               -   lda LAST_KEY                        ; wait for key press
   590  133f c940                   cmp #KEY_NONE
   591  1341 f0fa                   beq -
   592                          
   593  1343 a5c5               -   lda LAST_KEY                        ; wait for key release
   594  1345 c940                   cmp #KEY_NONE
   595  1347 d0fa                   bne -
   596                          
   597  1349 a9f5                   lda #$F5                            ; make the noise
   598  134b 8c0d90                 sty VIC_NOISE_FREQ
   599                          
   600  134e 60                     rts
   601                          
   602                          
   603                          ;======================================================================================
   604                          ; Show the title page
   605                          ;======================================================================================
   606                          SUB_TITLE:
   607  134f 209e13                 jsr SUB_START_TEXT_SCREEN
   608                          
   609  1352 a914                   lda #>TEXT_BUNNY_BLITZ
   610  1354 8539                   sta TEXT_MSB
   611  1356 a97c                   lda #<TEXT_BUNNY_BLITZ
   612  1358 8538                   sta TEXT_LSB
   613                          
   614  135a a91e                   lda #>SCREEN_RAM_LINE_00 + 5
   615  135c a205                   ldx #<SCREEN_RAM_LINE_00 + 5
   616  135e 201e14                 jsr SUB_PRINT_STRING
   617                          
   618  1361 a914                   lda #>TEXT_BY_ME
   619  1363 8539                   sta TEXT_MSB
   620  1365 a988                   lda #<TEXT_BY_ME
   621  1367 8538                   sta TEXT_LSB
   622                          
   623  1369 a91e                   lda #>SCREEN_RAM_LINE_02 + 3
   624  136b a22f                   ldx #<SCREEN_RAM_LINE_02 + 3
   625  136d 201e14                 jsr SUB_PRINT_STRING
   626                          
   627  1370 a914                   lda #>TEXT_BASED_ON
   628  1372 8539                   sta TEXT_MSB
   629  1374 a999                   lda #<TEXT_BASED_ON
   630  1376 8538                   sta TEXT_LSB
   631                          
   632  1378 a91e                   lda #>SCREEN_RAM_LINE_04
   633  137a a258                   ldx #<SCREEN_RAM_LINE_04
   634  137c 201e14                 jsr SUB_PRINT_STRING
   635                          
   636  137f 20b113                 jsr SUB_SHOW_STATS
   637                          
   638                              ; press the any key
   639  1382 a914                   lda #>TEXT_PRESS_A_KEY
   640  1384 8539                   sta TEXT_MSB
   641  1386 a9c0                   lda #<TEXT_PRESS_A_KEY
   642  1388 8538                   sta TEXT_LSB
   643                          
   644  138a a91f                   lda #>SCREEN_RAM_LINE_20 + 6
   645  138c a2be                   ldx #<SCREEN_RAM_LINE_20 + 6
   646  138e 201e14                 jsr SUB_PRINT_STRING
   647                          
   648  1391 a5c5               -   lda LAST_KEY                        ; wait for key press
   649  1393 c940                   cmp #KEY_NONE
   650  1395 f0fa                   beq -
   651                          
   652  1397 a5c5               -   lda LAST_KEY                        ; wait for key release
   653  1399 c940                   cmp #KEY_NONE
   654  139b d0fa                   bne -
   655                          
   656  139d 60                     rts
   657                          
   658                          
   659                          ;======================================================================================
   660                          ; Start a text screen, black background, white text
   661                          ;======================================================================================
   662                          SUB_START_TEXT_SCREEN:
   663  139e a940                   lda #KEY_NONE                       ; clear last keypress
   664  13a0 85c5                   sta LAST_KEY
   665                          
   666  13a2 200714                 jsr SUB_CLS                         ; clear the screen
   667                          
   668  13a5 a908                   lda #8                              ; black border and background
   669  13a7 8d0f90                 sta VIC_BORDER
   670                          
   671  13aa 8c0a90                 sty VIC_OSC1_FREQ                   ; sound off
   672  13ad 8c0d90                 sty VIC_NOISE_FREQ                  ; noise off
   673                          
   674  13b0 60                     rts
   675                          
   676                          ;======================================================================================
   677                          ; Show the user stats on a text page
   678                          ;======================================================================================
   679                          SUB_SHOW_STATS:
   680                              ; planes landed
   681  13b1 a915                   lda #>TEXT_PLANES
   682  13b3 8539                   sta TEXT_MSB
   683  13b5 a947                   lda #<TEXT_PLANES
   684  13b7 8538                   sta TEXT_LSB
   685                          
   686  13b9 a91e                   lda #>SCREEN_RAM_LINE_09
   687  13bb a2c6                   ldx #<SCREEN_RAM_LINE_09
   688  13bd 201e14                 jsr SUB_PRINT_STRING
   689                          
   690  13c0 a906                   lda #COLOUR_BLUE
   691  13c2 8dc696                 sta SCREEN_RAM_LINE_09 + COLOUR_RAM_OFFSET
   692                          
   693  13c5 a520                   lda SCORE
   694  13c7 8dc81e                 sta SCREEN_RAM_LINE_09 + 2
   695                          
   696                              ; bombs dropped
   697  13ca a915                   lda #>TEXT_BOMBS
   698  13cc 8539                   sta TEXT_MSB
   699  13ce a91c                   lda #<TEXT_BOMBS
   700  13d0 8538                   sta TEXT_LSB
   701                          
   702  13d2 a91f                   lda #>SCREEN_RAM_LINE_12
   703  13d4 a208                   ldx #<SCREEN_RAM_LINE_12
   704  13d6 201e14                 jsr SUB_PRINT_STRING
   705                          
   706  13d9 a902                   lda #COLOUR_RED
   707  13db 8d0897                 sta SCREEN_RAM_LINE_12 + COLOUR_RAM_OFFSET
   708                          
   709  13de a522                   lda BOMBS_TENS
   710  13e0 8d0a1f                 sta SCREEN_RAM_LINE_12 + 2
   711  13e3 a521                   lda BOMBS_UNITS
   712  13e5 8d0b1f                 sta SCREEN_RAM_LINE_12 + 3
   713                          
   714                              ; buildings flattened
   715  13e8 a914                   lda #>TEXT_BUILDINGS
   716  13ea 8539                   sta TEXT_MSB
   717  13ec a9de                   lda #<TEXT_BUILDINGS
   718  13ee 8538                   sta TEXT_LSB
   719                          
   720  13f0 a91f                   lda #>SCREEN_RAM_LINE_15
   721  13f2 a24a                   ldx #<SCREEN_RAM_LINE_15
   722  13f4 201e14                 jsr SUB_PRINT_STRING
   723                          
   724  13f7 a525                   lda BUILDINGS_HUNDREDS
   725  13f9 8d621f                 sta SCREEN_RAM_LINE_16 + 2
   726  13fc a524                   lda BUILDINGS_TENS
   727  13fe 8d631f                 sta SCREEN_RAM_LINE_16 + 3
   728  1401 a523                   lda BUILDINGS_UNITS
   729  1403 8d641f                 sta SCREEN_RAM_LINE_16 + 4
   730                          
   731  1406 60                     rts
   732                          
   733                          ;======================================================================================
   734                          ; Clear the screen
   735                          ;======================================================================================
   736                          SUB_CLS:
   737  1407 a920                   lda #CHAR_SPACE                     ; clear screen
   738  1409 99001e             -   sta SCREEN_RAM_PAGE0,y
   739  140c 99001f                 sta SCREEN_RAM_PAGE1,y
   740  140f c8                     iny
   741  1410 d0f7                   bne -
   742                          
   743  1412 a901                   lda #COLOUR_WHITE                   ; clear colour RAM
   744  1414 990096             -   sta COLOUR_RAM_PAGE0,y
   745  1417 990097                 sta COLOUR_RAM_PAGE1,y
   746  141a c8                     iny
   747  141b d0f7                   bne -
   748                          
   749  141d 60                     rts
   750                          
   751                          ;======================================================================================
   752                          ; Print a string
   753                          ; string pointed to by TEXT_MSB & TEXT_LSB
   754                          ; location A=MSB, X=LSB, (and Y=0 as is the law)
   755                          ;======================================================================================
   756                          SUB_PRINT_STRING:
   757  141e 853b                   sta TEXT_POS_MSB
   758  1420 863a                   stx TEXT_POS_LSB
   759                          
   760  1422 b138               -   lda (TEXT),y                        ; load the next character
   761  1424 f005                   beq +                               ; exit if 0
   762  1426 913a                   sta (TEXT_POS),y                    ; display the character
   763  1428 c8                     iny                                 ; next character
   764  1429 d0f7                   bne -                               ; loop back (will stop after 256 chars in no 0)
   765                          
   766  142b a000               +   ldy #0                              ; reset y
   767  142d 60                     rts
   768                          
   769                          ;======================================================================================
   770                          ; Delay the equivalent of FOR N=1 TO A : NEXT N
   771                          ; For 0<A<63
   772                          ; Clears X and Y
   773                          ;======================================================================================
   774                          DELAY:
   775  142e 0a                     asl                                 ; loop A*4*256
   776  142f 0a                     asl                                 ;
   777  1430 aa                     tax                                 ;
   778  1431 88                 -   dey                                 ;
   779  1432 d0fd                   bne -                               ;
   780  1434 ca                     dex                                 ;
   781  1435 d0fa                   bne -                               ;
   782  1437 60                     rts                                 ;
   783                          
   784                          ;======================================================================================
   785                          ; Pseudo-random-number generator. You can get 8-bit random numbers in A
   786                          ; or 16-bit numbers from the zero page addresses. Leaves X/Y unchanged.
   787                          ;
   788                          ; (36 clock cycles)
   789                          ;
   790                          ; See
   791                          ; https://web.archive.org/web/20250328001550/https://codebase64.org/doku.php?id=base:16bit_xorshift_random_generator
   792                          ; and
   793                          ; https://github.com/markgbeckett/pet/tree/main/examples
   794                          ;======================================================================================
   795                          RAND16:
   796  1438 a508                   lda SEED_MSB                        ; (3)
   797  143a 4a                     lsr			                        ; (2)
   798  143b a507                   lda SEED_LSB	                    ; (3)
   799  143d 6a                     ror			                        ; (2)
   800  143e 4508                   eor SEED_MSB	                    ; (3)
   801  1440 8508                   sta SEED_MSB	                    ; (3) high part of x ^= x << 7 done
   802  1442 6a                     ror             	                ; (2) A has now x >> 9 and high bit comes from low byte
   803  1443 4507                   eor SEED_LSB	                    ; (3)
   804  1445 8507                   sta SEED_LSB	                    ; (3) x ^= x >> 9 and the low part of x ^= x << 7 done
   805  1447 4508                   eor SEED_MSB	                    ; (3)
   806  1449 8508                   sta SEED_MSB	                    ; (3) x ^= x << 8 done
   807                          
   808  144b 60                     rts			                        ; (6)
   809                          
   810                          ;======================================================================================
   811                          ; Character Data
   812                          ;======================================================================================
   813                          
   814                          CharacterData:
   815                          ; Building
   816  144c ffffdbdbffffdbdb   !byte 255,255,219,219,255,255,219,219
   817                          
   818                          ; Plane
   819  1454 10189cffff9c1810   !byte 16,24,156,255,255,156,24,16
   820                          
   821                          ; Bomb
   822  145c 3c3c183c3c3c3c18   !byte 60,60,24,60,60,60,60,24
   823                          
   824                          ; Grass (solid square)
   825  1464 ffffffffffffffff   !byte 255,255,255,255,255,255,255,255
   826                          
   827                          ; Sky (empty square)
   828  146c 0000000000000000   !byte 0,0,0,0,0,0,0,0
   829                          
   830                          ; Roof (triangle)
   831  1474 00000000183c7eff   !byte 0,0,0,0,24,60,126,255
