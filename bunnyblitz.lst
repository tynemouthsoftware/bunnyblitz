   634  137e a9c6                   lda #<TEXT_PRESS_A_KEY
   635  1380 8538                   sta TEXT_LSB
   636                          
   637  1382 a91f                   lda #>SCREEN_RAM_LINE_20 + 6
   638  1384 a2be                   ldx #<SCREEN_RAM_LINE_20 + 6
   639  1386 201614                 jsr SUB_PRINT_STRING
   640                          
   641  1389 a5c5               -   lda LAST_KEY                        ; wait for key press
   642  138b c940                   cmp #KEY_NONE
   643  138d f0fa                   beq -
   644                          
   645  138f a5c5               -   lda LAST_KEY                        ; wait for key release
   646  1391 c940                   cmp #KEY_NONE
