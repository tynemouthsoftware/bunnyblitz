   528  12f4 a200                   ldx #<SCREEN_RAM_LINE_00
   529  12f6 201614                 jsr SUB_PRINT_STRING
   530                          
   531  12f9 20a913                 jsr SUB_SHOW_STATS
   532                          
   533                              ; fix the score
   534  12fc a931                   lda #CHAR_1
   535  12fe 8dc81e                 sta SCREEN_RAM_LINE_09 + 2
   536  1301 a930                   lda #CHAR_0
   537  1303 8dc91e                 sta SCREEN_RAM_LINE_09 + 3
   538                          
   539                              ; drop through
   540                          
   541                          ;======================================================================================
   542                          ; Another go, start or go to READY prompt
