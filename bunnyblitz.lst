    26                          
    27                          ;======================================================================================
    28                          ; Zero page Variables
    29                          ;======================================================================================
    30                          ; $00 and $01 get overwritten
    31                          
    32                          TEMP                    = $02
    33                          
    34                          SEED_LSB                = $07
    35                          SEED_MSB                = $08
    36                          SEED                    = SEED_LSB
    37                          
    38                          SKIP_TITLE              = $10
    39                          PLANE_DELAY             = $11
    40                          BOMB_NOTE               = $12
    41                          COL                     = $13
    42                          
    43                          SCORE                   = $20
    44                          
    45                          BOMBS_UNITS             = $21
    46                          BOMBS_TENS              = $22
    47                          
    48                          BUILDINGS_UNITS         = $23
    49                          BUILDINGS_TENS          = $24
    50                          BUILDINGS_HUNDREDS      = $25
    51                          
    52                          BUILDINGS_STANDING      = $26
    53                          
    54                          ;--------------------------------------------------------------------------------------
    55                          ; 16 bit Variables
    56                          ;--------------------------------------------------------------------------------------
    57                          
    58                          PLANE                   = $30
    59                          PLANE_LSB               = PLANE
    60                          PLANE_MSB               = PLANE + 1
    61                          
    62                          PLANE_COLOUR            = $32
    63                          PLANE_COLOUR_LSB        = PLANE_COLOUR
    64                          PLANE_COLOUR_MSB        = PLANE_COLOUR + 1
    65                          
    66                          BOMB                    = $34
    67                          BOMB_LSB                = BOMB
    68                          BOMB_MSB                = BOMB + 1
    69                          
    70                          BOMB_COLOUR             = $36
    71                          BOMB_COLOUR_LSB         = BOMB_COLOUR
    72                          BOMB_COLOUR_MSB         = BOMB_COLOUR + 1
    73                          
    74                          TEXT                    = $38
    75                          TEXT_LSB                = TEXT
    76                          TEXT_MSB                = TEXT+1
    77                          
    78                          TEXT_POS                = $3A
    79                          TEXT_POS_LSB            = TEXT_POS
    80                          TEXT_POS_MSB            = TEXT_POS + 1
    81                          
    82                          ;======================================================================================
    83                          ; Screen layout
    84                          ;======================================================================================
    85                          
    86                          SCREEN_RAM              = $1E00
    87                          SCREEN_RAM_PAGE0        = SCREEN_RAM + $0000
    88                          SCREEN_RAM_PAGE1        = SCREEN_RAM + $0100
    89                          
    90                          COLOUR_RAM              = $9600
    91                          COLOUR_RAM_PAGE0        = COLOUR_RAM + $0000
    92                          COLOUR_RAM_PAGE1        = COLOUR_RAM + $0100
    93                          
    94                          CHAR_RAM                = $1C00
    95                          CHAR_RAM_PAGE0          = CHAR_RAM + $0000
    96                          CHAR_RAM_PAGE1          = CHAR_RAM + $0100
    97                          
    98                          CHAR_ROM                = $8000
    99                          CHAR_ROM_PAGE0          = CHAR_ROM + $0000
   100                          CHAR_ROM_PAGE1          = CHAR_ROM + $0100
   101                          
   102                          SCREEN_WIDTH            = 22
   103                          SCREEN_HEIGHT           = 23
   104                          
   105                          COLOUR_RAM_OFFSET       = COLOUR_RAM - SCREEN_RAM
   106                          COLOUR_RAM_OFFSET_MSB   = (>COLOUR_RAM) - (>SCREEN_RAM)
   107                          
   108                          SCREEN_RAM_LINE_00      = SCREEN_RAM + (SCREEN_WIDTH *  0)
   109                          SCREEN_RAM_LINE_02      = SCREEN_RAM + (SCREEN_WIDTH *  2)
   110                          SCREEN_RAM_LINE_04      = SCREEN_RAM + (SCREEN_WIDTH *  4)
   111                          SCREEN_RAM_LINE_07      = SCREEN_RAM + (SCREEN_WIDTH *  7)
   112                          SCREEN_RAM_LINE_09      = SCREEN_RAM + (SCREEN_WIDTH *  9)
   113                          SCREEN_RAM_LINE_12      = SCREEN_RAM + (SCREEN_WIDTH * 12)
   114                          SCREEN_RAM_LINE_15      = SCREEN_RAM + (SCREEN_WIDTH * 15)
   115                          SCREEN_RAM_LINE_16      = SCREEN_RAM + (SCREEN_WIDTH * 16)
   116                          SCREEN_RAM_LINE_20      = SCREEN_RAM + (SCREEN_WIDTH * 20)
   117                          SCREEN_RAM_LINE_21      = SCREEN_RAM + (SCREEN_WIDTH * 21)
   118                          
   119                          SKYLINE                 = SCREEN_RAM_LINE_09
   120                          SKYLINE_COL             = SKYLINE + COLOUR_RAM_OFFSET
   121                          
   122                          ; Stats line
   123                          ; 0123456789012345678901
   124                          ;   X 123   X 12   X 1
   125                          
   126                          SCREEN_STATS_LINE       = SCREEN_RAM_LINE_21
   127                          
   128                          SCREEN_TB_LOGO          = SCREEN_STATS_LINE +  2
   129                          
   130                          SCREEN_TB_HUNDREDS      = SCREEN_STATS_LINE +  4
   131                          SCREEN_TB_TENS          = SCREEN_STATS_LINE +  5
   132                          SCREEN_TB_UNITS         = SCREEN_STATS_LINE +  6
   133                          
   134                          SCREEN_B_LOGO           = SCREEN_STATS_LINE + 10
   135                          
   136                          SCREEN_B_TENS           = SCREEN_STATS_LINE + 12
   137                          SCREEN_B_UNITS          = SCREEN_STATS_LINE + 13
   138                          
   139                          SCREEN_SC_LOGO          = SCREEN_STATS_LINE + 17
   140                          
   141                          SCREEN_SC_UNITS         = SCREEN_STATS_LINE + 19
   142                          
   143                          GROUND_POS              = SCREEN_RAM_LINE_20
   144                          GROUND_COLOUR           = GROUND_POS + COLOUR_RAM_OFFSET
   145                          
   146                          BUILDING_MAX_HEIGHT     = GROUND_POS - SKYLINE - SCREEN_WIDTH
   147                          
   148                          ;======================================================================================
   149                          ; Characters
   150                          ;======================================================================================
   151                          
   152                          UDG_BASE                = $21
   153                          UDG_BUIDLING            = UDG_BASE + $00
   154                          UDG_PLANE               = UDG_BASE + $01
   155                          UDG_BOMB                = UDG_BASE + $02
   156                          UDG_GRASS               = UDG_BASE + $03
   157                          UDG_SKY                 = UDG_BASE + $04
   158                          UDG_ROOF                = UDG_BASE + $05
   159                          
   160                          UDG_DATA                = CHAR_RAM + (8 * UDG_BASE)
   161                          
   162                          CHAR_SPACE              = $20
   163                          CHAR_0                  = $30
   164                          CHAR_1                  = $31
   165                          CHAR_3                  = $33
   166                          CHAR_9                  = $39
   167                          CHAR_10                 = $3A
   168                          
   169                          ;======================================================================================
   170                          ; Keys
   171                          ;======================================================================================
   172                          
   173                          KEY_N                   = $1C
   174                          KEY_Y                   = $0B
   175                          KEY_SPACE               = $20
   176                          KEY_UP_ARROW            = $36
   177                          KEY_NONE                = $40
   178                          
   179                          ;======================================================================================
   180                          ; Colours
   181                          ;======================================================================================
   182                          COLOUR_BLACK            = $00
   183                          COLOUR_WHITE            = $01
   184                          COLOUR_RED              = $02
   185                          COLOUR_CYAN             = $03
   186                          COLOUR_VIOLET           = $04
   187                          COLOUR_PURPLE           = $04 ; == VIOLET
   188                          COLOUR_GREEN            = $05
   189                          COLOUR_BLUE             = $06
   190                          COLOUR_YELLOW           = $07
   191                          COLOUR_ORANGE           = $08
   192                          COLOUR_BROWN            = $09
   193                          COLOUR_LIGHTRED         = $0A
   194                          COLOUR_GRAY1            = $0B
   195                          COLOUR_GRAY2            = $0C
   196                          COLOUR_LIGHTGREEN       = $0D
   197                          COLOUR_LIGHTBLUE        = $0E
   198                          COLOUR_GRAY3            = $0F
