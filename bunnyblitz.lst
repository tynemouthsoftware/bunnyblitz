   652                          ;======================================================================================
   653                          ; Start a text screen, black background, white text
   654                          ;======================================================================================
   655                          SUB_START_TEXT_SCREEN:
   656  1396 a940                   lda #KEY_NONE                       ; clear last keypress
   657  1398 85c5                   sta LAST_KEY
   658                          
   659  139a 20ff13                 jsr SUB_CLS                         ; clear the screen
   660                          
   661  139d a908                   lda #8                              ; black border and background
   662  139f 8d0f90                 sta VIC_BORDER
   663                          
   664  13a2 8c0a90                 sty VIC_OSC1_FREQ                   ; sound off
   665  13a5 8c0d90                 sty VIC_NOISE_FREQ                  ; noise off
   666                          
   667  13a8 60                     rts
   668                          
   669                          ;======================================================================================
   670                          ; Show the user stats on a text page
   671                          ;======================================================================================
   672                          SUB_SHOW_STATS:
   673                              ; planes landed
   674  13a9 a915                   lda #>TEXT_PLANES
   675  13ab 8539                   sta TEXT_MSB
   676  13ad a94d                   lda #<TEXT_PLANES
   677  13af 8538                   sta TEXT_LSB
   678                          
   679  13b1 a91e                   lda #>SCREEN_RAM_LINE_09
   680  13b3 a2c6                   ldx #<SCREEN_RAM_LINE_09
   681  13b5 201614                 jsr SUB_PRINT_STRING
   682                          
   683  13b8 a906                   lda #COLOUR_BLUE
   684  13ba 8dc696                 sta SCREEN_RAM_LINE_09 + COLOUR_RAM_OFFSET
   685                          
   686  13bd a520                   lda SCORE
   687  13bf 8dc81e                 sta SCREEN_RAM_LINE_09 + 2
   688                          
   689                              ; bombs dropped
   690  13c2 a915                   lda #>TEXT_BOMBS
   691  13c4 8539                   sta TEXT_MSB
   692  13c6 a922                   lda #<TEXT_BOMBS
   693  13c8 8538                   sta TEXT_LSB
   694                          
   695  13ca a91f                   lda #>SCREEN_RAM_LINE_12
   696  13cc a208                   ldx #<SCREEN_RAM_LINE_12
   697  13ce 201614                 jsr SUB_PRINT_STRING
   698                          
   699  13d1 a902                   lda #COLOUR_RED
   700  13d3 8d0897                 sta SCREEN_RAM_LINE_12 + COLOUR_RAM_OFFSET
   701                          
   702  13d6 a522                   lda BOMBS_TENS
   703  13d8 8d0a1f                 sta SCREEN_RAM_LINE_12 + 2
   704  13db a521                   lda BOMBS_UNITS
   705  13dd 8d0b1f                 sta SCREEN_RAM_LINE_12 + 3
   706                          
   707                              ; buildings flattened
   708  13e0 a914                   lda #>TEXT_BUILDINGS
   709  13e2 8539                   sta TEXT_MSB
   710  13e4 a9e4                   lda #<TEXT_BUILDINGS
   711  13e6 8538                   sta TEXT_LSB
   712                          
   713  13e8 a91f                   lda #>SCREEN_RAM_LINE_15
   714  13ea a24a                   ldx #<SCREEN_RAM_LINE_15
   715  13ec 201614                 jsr SUB_PRINT_STRING
   716                          
   717  13ef a525                   lda BUILDINGS_HUNDREDS
   718  13f1 8d621f                 sta SCREEN_RAM_LINE_16 + 2
   719  13f4 a524                   lda BUILDINGS_TENS
   720  13f6 8d631f                 sta SCREEN_RAM_LINE_16 + 3
   721  13f9 a523                   lda BUILDINGS_UNITS
   722  13fb 8d641f                 sta SCREEN_RAM_LINE_16 + 4
   723                          
   724  13fe 60                     rts
   725                          
   726                          ;======================================================================================
   727                          ; Clear the screen
   728                          ;======================================================================================
   729                          SUB_CLS:
   730  13ff a920                   lda #CHAR_SPACE                     ; clear screen
   731  1401 99001e             -   sta SCREEN_RAM_PAGE0,y
   732  1404 99001f                 sta SCREEN_RAM_PAGE1,y
   733  1407 c8                     iny
   734  1408 d0f7                   bne -
   735                          
   736  140a a901                   lda #COLOUR_WHITE                   ; clear colour RAM
   737  140c 990096             -   sta COLOUR_RAM_PAGE0,y
   738  140f 990097                 sta COLOUR_RAM_PAGE1,y
   739  1412 c8                     iny
   740  1413 d0f7                   bne -
   741                          
   742  1415 60                     rts
   743                          
   744                          ;======================================================================================
   745                          ; Print a string
   746                          ; string pointed to by TEXT_MSB & TEXT_LSB
   747                          ; location A=MSB, X=LSB, (and Y=0 as is the law)
   748                          ;======================================================================================
   749                          SUB_PRINT_STRING:
   750  1416 853b                   sta TEXT_POS_MSB
   751  1418 863a                   stx TEXT_POS_LSB
   752                          
   753  141a b138               -   lda (TEXT),y                        ; load the next character
   754  141c f005                   beq +                               ; exit if 0
   755  141e 913a                   sta (TEXT_POS),y                    ; display the character
   756  1420 c8                     iny                                 ; next character
   757  1421 d0f7                   bne -                               ; loop back (will stop after 256 chars in no 0)
   758                          
   759  1423 a000               +   ldy #0                              ; reset y
   760  1425 60                     rts
   761                          
   762                          ;======================================================================================
   763                          ; Delay the equivalent of FOR N=1 TO A : NEXT N
   764                          ; For 0<A<63
   765                          ; Clears X and Y
   766                          ;======================================================================================
   767                          DELAY:
   768  1426 0a                     asl                                 ; loop A*4*256
   769  1427 0a                     asl                                 ;
   770  1428 aa                     tax                                 ;
   771  1429 88                 -   dey                                 ;
   772  142a d0fd                   bne -                               ;
   773  142c ca                     dex                                 ;
   774  142d d0fa                   bne -                               ;
   775  142f 60                     rts                                 ;
   776                          
   777                          ;======================================================================================
   778                          ; Return a random number from 0 to X-1 in A
   779                          ; Where 0 < X < 8
   780                          ; Start at 0 and add 1 for each 1 in X bits of the 8 bit random number
   781                          ;======================================================================================
   782                          RND:
   783  1430 203e14                 jsr RAND16                          ; get a random number in A
   784  1433 8502                   sta TEMP                            ; store in temporary location
   785  1435 98                     tya                                 ; A=0
   786  1436 4602               -   lsr TEMP                            ; 0 -> TEMP -> carry
   787  1438 6900                   adc #0                              ; A=A+0+carry
   788  143a ca                     dex                                 ;
   789  143b d0f9                   bne -                               ; loop back
   790  143d 60                     rts                                 ; return with value in A
   791                          
   792                          ;======================================================================================
   793                          ; Pseudo-random-number generator. You can get 8-bit random numbers in A
   794                          ; or 16-bit numbers from the zero page addresses. Leaves X/Y unchanged.
   795                          ;
   796                          ; (36 clock cycles)
   797                          ;
   798                          ; See
   799                          ; https://web.archive.org/web/20250328001550/https://codebase64.org/doku.php?id=base:16bit_xorshift_random_generator
   800                          ; and
   801                          ; https://github.com/markgbeckett/pet/tree/main/examples
   802                          ;======================================================================================
   803                          RAND16:
   804  143e a508                   lda SEED_MSB                        ; (3)
   805  1440 4a                     lsr			                        ; (2)
   806  1441 a507                   lda SEED_LSB	                    ; (3)
   807  1443 6a                     ror			                        ; (2)
   808  1444 4508                   eor SEED_MSB	                    ; (3)
   809  1446 8508                   sta SEED_MSB	                    ; (3) high part of x ^= x << 7 done
   810  1448 6a                     ror             	                ; (2) A has now x >> 9 and high bit comes from low byte
   811  1449 4507                   eor SEED_LSB	                    ; (3)
   812  144b 8507                   sta SEED_LSB	                    ; (3) x ^= x >> 9 and the low part of x ^= x << 7 done
   813  144d 4508                   eor SEED_MSB	                    ; (3)
   814  144f 8508                   sta SEED_MSB	                    ; (3) x ^= x << 8 done
   815                          
   816  1451 60                     rts			                        ; (6)
   817                          
   818                          ;======================================================================================
   819                          ; Character Data
   820                          ;======================================================================================
   821                          
   822                          CharacterData:
   823                          ; Building
   824  1452 ffffdbdbffffdbdb   !byte 255,255,219,219,255,255,219,219
   825                          
   826                          ; Plane
   827  145a 10189cffff9c1810   !byte 16,24,156,255,255,156,24,16
   828                          
   829                          ; Bomb
   830  1462 3c3c183c3c3c3c18   !byte 60,60,24,60,60,60,60,24
