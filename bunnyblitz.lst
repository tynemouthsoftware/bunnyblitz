   609  1356 201614                 jsr SUB_PRINT_STRING
   610                          
   611  1359 a914                   lda #>TEXT_BY_ME
   612  135b 8539                   sta TEXT_MSB
   613  135d a98e                   lda #<TEXT_BY_ME
   614  135f 8538                   sta TEXT_LSB
   615                          
   616  1361 a91e                   lda #>SCREEN_RAM_LINE_02 + 3
   617  1363 a22f                   ldx #<SCREEN_RAM_LINE_02 + 3
   618  1365 201614                 jsr SUB_PRINT_STRING
   619                          
   620  1368 a914                   lda #>TEXT_BASED_ON
   621  136a 8539                   sta TEXT_MSB
   622  136c a99f                   lda #<TEXT_BASED_ON
   623  136e 8538                   sta TEXT_LSB
   624                          
   625  1370 a91e                   lda #>SCREEN_RAM_LINE_04
   626  1372 a258                   ldx #<SCREEN_RAM_LINE_04
   627  1374 201614                 jsr SUB_PRINT_STRING
   628                          
   629  1377 20a913                 jsr SUB_SHOW_STATS
   630                          
   631                              ; press the any key
   632  137a a914                   lda #>TEXT_PRESS_A_KEY
