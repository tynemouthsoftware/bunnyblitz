; ******** Source: bunnyblitz.asm
    14                          
    15                          ; BASIC loader stub
    16                          ; 6502 SYS 4109
    17                          *=$1001
    18  1001 0b10                   !word end_of_stub                   ; link to next line (end of BASIC stub)
    19  1003 6619                   !word 6502                          ; line number (can be anything, so why not)
    20  1005 9e                     !byte SYS                           ; SYS token
    21  1006 34313039               !text "4109"                        ; start of init code ($100D)
    22  100a 00                     !byte 0                             ; end of line
    23                          end_of_stub
    24  100b 0000                   !word 0                             ; end of BASIC stub
    25                          
    26                          ;===================================================================================================
    27                          ; Initialise once only
    28                          ;===================================================================================================
    29  100d a000                   ldy #0                              ; always leave Y as 0
    30  100f 8410                   sty SKIP_TITLE                      ; do not skip title the first time
    31                          
    32  1011 ad1891                 lda VIA1_TIMER2_LSB                 ; seed RND from the VIA timer
    33  1014 8507                   sta SEED_LSB
    34  1016 ad1991                 lda VIA1_TIMER2_MSB
    35  1019 8508                   sta SEED_MSB
    36                          
    37  101b b90080             -   lda CHAR_ROM_PAGE0,y                ; copy character ROM
    38  101e 99001c                 sta CHAR_RAM_PAGE0,y                ; into character RAM
    39  1021 b90081                 lda CHAR_ROM_PAGE1,y
    40  1024 99001d                 sta CHAR_RAM_PAGE1,y
    41  1027 c8                     iny
    42  1028 d0f1                   bne -
    43                          
    44  102a a200                   ldx #0                              ; copy user defined characters
    45  102c bd5214             -   lda CharacterData,x
    46  102f 9d081d                 sta UDG_DATA,x                      ; into character RAM
    47  1032 e8                     inx
    48  1033 e030                   cpx #6 * 8                          ; 6 characters, 8 bytes per character
    49  1035 d0f5                   bne -
    50                          
    51  1037 a9ff                   lda #$FF                            ; character memory $1C00, screen $1E00
    52  1039 8d0590                 sta VIC_ADDRESSING
    53                          
    54                          ;===================================================================================================
    55                          ; Start / restart game
    56                          ;===================================================================================================
    57                          start:
    58                          
    59  103c a930                   lda #CHAR_0                         ; initialise stats variables
    60  103e 8520                   sta SCORE
    61  1040 8521                   sta BOMBS_UNITS
    62  1042 8522                   sta BOMBS_TENS
    63  1044 8523                   sta BUILDINGS_UNITS
    64  1046 8524                   sta BUILDINGS_TENS
    65  1048 8525                   sta BUILDINGS_HUNDREDS
    66                          
    67  104a a914                   lda #20                             ; set inital speed
    68  104c 8511                   sta PLANE_DELAY
    69                          
    70  104e a9fe                   lda #$FE                            ; reset bomb sound
    71  1050 8512                   sta BOMB_NOTE
    72                          
    73  1052 a90f                   lda #15                             ; maximum power!
    74  1054 8d0e90                 sta VIC_VOLUME
    75                          
    76  1057 a5c5               -   lda LAST_KEY                        ; wait for key release
    77  1059 c940                   cmp #KEY_NONE
    78  105b d0fa                   bne -
    79                          
    80  105d a510                   lda SKIP_TITLE                      ; skip the title if not the first time
    81  105f d005                   bne NEW_LEVEL
    82                          
    83  1061 204713                 jsr SUB_TITLE                       ; show the title screen
    84  1064 e610                   inc SKIP_TITLE                      ; skip it next time
    85                          
    86                          ;===================================================================================================
    87                          ; Start a new level
    88                          ;===================================================================================================
    89                          NEW_LEVEL:
    90  1066 a91e                   lda #>SCREEN_RAM                    ; reset plane position
    91  1068 8531                   sta PLANE_MSB
    92  106a a996                   lda #>COLOUR_RAM
    93  106c 8533                   sta PLANE_COLOUR_MSB
    94  106e 8430                   sty PLANE_LSB
    95  1070 8432                   sty PLANE_COLOUR_LSB
    96                          
    97  1072 20ff13                 jsr SUB_CLS                         ; clear the screen
    98                          
    99  1075 a919                   lda #25                             ; white border and background
   100  1077 8d0f90                 sta VIC_BORDER
   101                          
   102  107a c611                   dec PLANE_DELAY                     ; increase the plane speed each level
   103                          
   104  107c a930                   lda #CHAR_0                         ; reset bombs count
   105  107e 8521                   sta BOMBS_UNITS
   106  1080 8522                   sta BOMBS_TENS
   107                          
   108                              ; draw the grass on the bottom three rows
   109  1082 a242                   ldx #3 * SCREEN_WIDTH
   110                          -
   111  1084 a924                   lda #UDG_GRASS                      ; grass is apparently just a solid square
   112  1086 9db81f                 sta GROUND_POS,x
   113  1089 a905                   lda #COLOUR_GREEN                   ; at least it is green
   114  108b 9db897                 sta GROUND_COLOUR,x
   115  108e ca                     dex
   116  108f 10f3                   bpl -
   117                          
   118                              ; setup stats display
   119  1091 a921                   lda #UDG_BUIDLING
   120  1093 8dd01f                 sta SCREEN_TB_LOGO
   121                          
   122  1096 a923                   lda #UDG_BOMB
   123  1098 8dd81f                 sta SCREEN_B_LOGO
   124                          
   125  109b a922                   lda #UDG_PLANE
   126  109d 8ddf1f                 sta SCREEN_SC_LOGO
   127                          
   128  10a0 a920                   lda #CHAR_SPACE
   129  10a2 8dd11f                 sta SCREEN_TB_LOGO+1
   130  10a5 8dd91f                 sta SCREEN_B_LOGO+1
   131  10a8 8de01f                 sta SCREEN_SC_LOGO+1
   132                          
   133  10ab a930                   lda #CHAR_0
   134  10ad 8dd21f                 sta SCREEN_TB_HUNDREDS
   135  10b0 8dd31f                 sta SCREEN_TB_TENS
   136  10b3 8dd41f                 sta SCREEN_TB_UNITS
   137  10b6 8dda1f                 sta SCREEN_B_TENS
   138  10b9 8ddb1f                 sta SCREEN_B_UNITS
   139  10bc 8de11f                 sta SCREEN_SC_UNITS
   140                          
   141  10bf a902                   lda #COLOUR_RED
   142  10c1 8dd897                 sta SCREEN_B_LOGO + COLOUR_RAM_OFFSET
   143                          
   144  10c4 a906                   lda #COLOUR_BLUE
   145  10c6 8ddf97                 sta SCREEN_SC_LOGO + COLOUR_RAM_OFFSET
   146                          
   147  10c9 a900                   lda #COLOUR_BLACK
   148  10cb 8dd097                 sta SCREEN_TB_LOGO + COLOUR_RAM_OFFSET
   149  10ce 8dd297                 sta SCREEN_TB_HUNDREDS + COLOUR_RAM_OFFSET
   150  10d1 8dd397                 sta SCREEN_TB_TENS + COLOUR_RAM_OFFSET
   151  10d4 8dd497                 sta SCREEN_TB_UNITS + COLOUR_RAM_OFFSET
   152  10d7 8dda97                 sta SCREEN_B_TENS + COLOUR_RAM_OFFSET
   153  10da 8ddb97                 sta SCREEN_B_UNITS + COLOUR_RAM_OFFSET
   154  10dd 8de197                 sta SCREEN_SC_UNITS + COLOUR_RAM_OFFSET
   155                          
   156                              ; add the buildings
   157  10e0 8413                   sty COL                             ; start in column 0
   158  10e2 8426                   sty BUILDINGS_STANDING              ; no buildings so far
   159                          
   160                          buildloop:
   161  10e4 a206                   ldx #6                              ; get random number from 0-5
   162  10e6 203014                 jsr RND                             ;
   163                          
   164  10e9 c904                   cmp #4                              ; check value, >= 4?
   165  10eb b029                   bcs nextcol                         ; skip building
   166                          
   167  10ed e626                   inc BUILDINGS_STANDING              ; we have a new building
   168                          
   169  10ef aa                     tax                                 ; X = number of storeys
   170                          
   171  10f0 a513                   lda COL                             ; offset starts as column
   172                          
   173  10f2 e8                     inx                                 ; 0-3 -> 1-4
   174  10f3 18                     clc
   175                          offsetloop:
   176  10f4 692c                   adc #2 * SCREEN_WIDTH               ; add 2 lines at a time
   177  10f6 ca                     dex
   178  10f7 d0fb                   bne offsetloop
   179                          
   180  10f9 aa                     tax                                 ; X = offset
   181  10fa a926                   lda #UDG_ROOF                       ; draw the roof
   182  10fc 9dc61e                 sta SKYLINE,x                       ;
   183  10ff 98                     tya                                 ; set the roof colour to black (0)
   184  1100 9dc696                 sta SKYLINE_COL,x                   ;
   185                          
   186  1103 18                     clc
   187                          drawloop:
   188  1104 8a                     txa                                 ; X = X + 22
   189  1105 6916                   adc #SCREEN_WIDTH                   ;
   190  1107 aa                     tax                                 ;
   191                          
   192  1108 a921                   lda #UDG_BUIDLING                   ; draw the building
   193  110a 9dc61e                 sta SKYLINE,x                       ;
   194  110d a900                   lda #COLOUR_BLACK                   ; set the building colour
   195  110f 9dc696                 sta SKYLINE_COL,x                   ;
   196  1112 e0dc                   cpx #BUILDING_MAX_HEIGHT            ; reached the limit?
   197  1114 90ee                   bcc drawloop
   198                          
   199                          nextcol:
   200  1116 e613                   inc COL                             ; move to the next column
   201  1118 a513                   lda COL                             ; check < 22 columns
   202  111a c916                   cmp #SCREEN_WIDTH
   203  111c d0c6                   bne buildloop
   204                          
   205                              ; drop through
   206                          
   207                          ;======================================================================================
   208                          ; The main game loop
   209                          ;======================================================================================
   210                          MAIN_LOOP:
   211                              ; draw the plane
   212  111e a922                   lda #UDG_PLANE
   213  1120 9130                   sta (PLANE),y
   214  1122 a906                   lda #COLOUR_BLUE
   215  1124 9132                   sta (PLANE_COLOUR),y
   216                          
   217                              ; plane flight delay
   218  1126 a511                   lda PLANE_DELAY
   219  1128 202614                 jsr DELAY
   220                          
   221                              ; print stats
   222  112b a521                   lda BOMBS_UNITS
   223  112d 8ddb1f                 sta SCREEN_B_UNITS
   224  1130 a522                   lda BOMBS_TENS
   225  1132 8dda1f                 sta SCREEN_B_TENS
   226                          
   227  1135 a525                   lda BUILDINGS_HUNDREDS
   228  1137 8dd21f                 sta SCREEN_TB_HUNDREDS
   229  113a a524                   lda BUILDINGS_TENS
   230  113c 8dd31f                 sta SCREEN_TB_TENS
   231  113f a523                   lda BUILDINGS_UNITS
   232  1141 8dd41f                 sta SCREEN_TB_UNITS
   233                          
   234  1144 a520                   lda SCORE
   235  1146 8de11f                 sta SCREEN_SC_UNITS
   236                          
   237  1149 a5c5               -   lda LAST_KEY                        ; check last key pressed
   238  114b c920                   cmp #KEY_SPACE                      ; was it SPACE ?
   239  114d d003                   bne +
   240  114f 201412                 JSR DROP_BOMB                       ; yes, drop a bomb
   241                          
   242  1152 c8                 +   iny                                 ; no, check if we hit anything
   243  1153 b130                   lda (PLANE),y                       ; Y=1, check next character
   244  1155 88                     dey                                 ; Y back to zero, phew
   245  1156 c926                   cmp #UDG_ROOF                       ; was it a bit of building?
   246  1158 f073                   beq CRASHED                         ; yes
   247  115a c921                   cmp #UDG_BUIDLING
   248  115c f06f                   beq CRASHED                         ; also yes
   249                          
   250  115e a016                   ldy #SCREEN_WIDTH                   ; no, so check below for ground
   251  1160 b130                   lda (PLANE),y
   252  1162 a000                   ldy #0
   253  1164 c924                   cmp #UDG_GRASS                      ; have we landed?
   254  1166 f02a                   beq TAXI_HOME                       ; yes
   255                          
   256                              ; not landed yet
   257                          
   258                              ; the ↑ key is pause - who knew?
   259  1168 a5c5                   lda LAST_KEY
   260  116a c936                   cmp #KEY_UP_ARROW
   261  116c d003                   bne +
   262  116e 202913                 jsr SUB_PAUSE
   263                          
   264  1171 a925               +   lda #UDG_SKY                        ; hide the old plane position
   265  1173 9130                   sta (PLANE),y
   266                          
   267  1175 a901                   lda #1                              ; move 1 square to the right
   268  1177 a626                   ldx BUILDINGS_STANDING              ; check if all the buildings are gone?
   269  1179 d002                   bne +
   270  117b a917                   lda #SCREEN_WIDTH + 1               ; yes, start to descend, 1 right, 1 down
   271                          
   272  117d 18                 +   clc                                 ; add 1 or 23 to the plane position
   273  117e 6530                   adc PLANE_LSB
   274  1180 8530                   sta PLANE_LSB                       ; update postition and colour
   275  1182 8532                   sta PLANE_COLOUR_LSB
   276  1184 9004                   bcc +
   277  1186 e631                   inc PLANE_MSB
   278  1188 e633                   inc PLANE_COLOUR_MSB
   279                          
   280  118a a9f5               +   lda #$F5                            ; make the noise
   281  118c 8d0d90                 sta VIC_NOISE_FREQ
   282                          
   283  118f 4c1e11                 jmp MAIN_LOOP                       ; and repeat until we hit something or land
   284                          
   285                          
   286                          ;======================================================================================
   287                          ; Taxi the plane to the right hand edge
   288                          ;======================================================================================
   289                          TAXI_HOME:
   290  1192 8c0d90                 sty VIC_NOISE_FREQ                  ; kill the noise
   291  1195 8c0a90                 sty VIC_OSC1_FREQ                   ; sound off
   292                          
   293                          -
   294  1198 a922                   lda #UDG_PLANE                      ; draw the plane
   295  119a 9130                   sta (PLANE),y
   296  119c a906                   lda #COLOUR_BLUE
   297  119e 9132                   sta (PLANE_COLOUR),y
   298                          
   299  11a0 a932                   lda #50                             ; taxing slowly
   300  11a2 202614                 jsr DELAY
   301                          
   302  11a5 a925                   lda #UDG_SKY                        ; hide the old plane position
   303  11a7 9130                   sta (PLANE),y
   304                          
   305  11a9 e630                   inc PLANE_LSB                       ; move along one square
   306  11ab e632                   inc PLANE_COLOUR_LSB
   307  11ad d004                   bne +
   308  11af e631                   inc PLANE_MSB
   309  11b1 e633                   inc PLANE_COLOUR_MSB
   310                          
   311  11b3 a531               +   lda PLANE_MSB                       ; has the plane reached the far right edge?
   312  11b5 c91f                   cmp #>GROUND_POS                    ;
   313  11b7 d004                   bne +                               ; different, so no need to check LSB
   314  11b9 a530                   lda PLANE_LSB                       ; compare LSB instead
   315  11bb c9b8                   cmp #<GROUND_POS                    ;
   316  11bd 90d9               +   bcc -                               ; no keep looping
   317                          
   318                              ; Plane has landed safely
   319  11bf e620                   inc SCORE                           ; increase score
   320                          
   321  11c1 a520                   lda SCORE                           ; has the user scored 10 landings?
   322  11c3 c93a                   cmp #CHAR_10
   323  11c5 d003                   bne +
   324  11c7 4ce712                 jmp LANDED_10                       ; yes, celebrate
   325                          +
   326  11ca 4c6610                 jmp NEW_LEVEL                       ; start the next level
   327                          
   328                          
   329                          ;======================================================================================
   330                          ; oh, now we hit someone, Mrs Webb
   331                          ;======================================================================================
   332                          CRASHED:
   333  11cd a996                   lda #$96
   334  11cf 8d0d90                 sta VIC_NOISE_FREQ
   335                          
   336                              ; shake the screen 10 times
   337  11d2 a90a                   lda #10
   338  11d4 8502                   sta TEMP
   339                          
   340  11d6 a932               -   lda #50
   341  11d8 8d0190                 sta VIC_VERTICAL_CENTRE
   342                          
   343  11db a919                   lda #25                             ; delay for 25
   344  11dd 202614                 jsr DELAY
   345                          
   346  11e0 a91e                   lda #30
   347  11e2 8d0190                 sta VIC_VERTICAL_CENTRE
   348                          
   349  11e5 a919                   lda #25                             ; delay for 25
   350  11e7 202614                 jsr DELAY
   351                          
   352  11ea c602                   dec TEMP
   353  11ec d0e8                   bne -
   354                          
   355  11ee ade5ed                 lda KERNAL_VIC_REGS_VC              ; restore the original value of vertical centering
   356  11f1 8d0190                 sta VIC_VERTICAL_CENTRE
   357                          
   358                              ; flash the border
   359  11f4 8402                   sty TEMP
   360                          
   361  11f6 a502               -   lda TEMP
   362  11f8 8d0f90                 sta VIC_BORDER
   363                          
   364  11fb a932                   lda #50
   365  11fd 202614                 jsr DELAY
   366  1200 a932                   lda #50
   367  1202 202614                 jsr DELAY
   368                          
   369  1205 a502                   lda TEMP
   370  1207 18                     clc
   371  1208 6916                   adc #22
   372  120a 8502                   sta TEMP
   373  120c 90e8                   bcc -
   374                          
   375  120e 8c0d90                 sty VIC_NOISE_FREQ                  ; stop the noise
   376                          
   377  1211 4ccf12                 jmp YOU_CRASHED
   378                          
   379                          ;======================================================================================
   380                          ; Drop a bomb
   381                          ;======================================================================================
   382                          DROP_BOMB:
   383  1214 a522                   lda BOMBS_TENS                      ; check bomb count
   384  1216 c933                   cmp #CHAR_3                         ; max is 30
   385  1218 9001                   bcc +
   386  121a 60                     rts                                 ; max bombs used, do nothing
   387                          
   388                              ; drop the bomb
   389  121b a530               +   lda PLANE_LSB                       ; bomb starts at plane position
   390  121d 8534                   sta BOMB_LSB
   391  121f 8536                   sta BOMB_COLOUR_LSB
   392                          
   393  1221 a531                   lda PLANE_MSB
   394  1223 8535                   sta BOMB_MSB
   395  1225 a533                   lda PLANE_COLOUR_MSB
   396  1227 8537                   sta BOMB_COLOUR_MSB
   397                          
   398                          bombloop:
   399  1229 a923                   lda #UDG_BOMB                       ; draw the bomb
   400  122b 9134                   sta (BOMB),y
   401  122d a902                   lda #COLOUR_RED                     ; colour the bomb
   402  122f 9136                   sta (BOMB_COLOUR),y                
   403  1231 a512                   lda BOMB_NOTE
   404  1233 8d0a90                 sta VIC_OSC1_FREQ                   ; bomb in flight
   405                          
   406  1236 a90a                   lda #10                             ; delay for 10
   407  1238 202614                 jsr DELAY
   408                          
   409  123b a925                   lda #UDG_SKY                        ; hide the bomb
   410  123d 9134                   sta (BOMB),y
   411                          
   412  123f c612                   dec BOMB_NOTE                       ; change the bomb note
   413  1241 c612                   dec BOMB_NOTE
   414                          
   415  1243 a016                   ldy #SCREEN_WIDTH                   ; check the line below
   416  1245 b134                   lda (BOMB),y
   417  1247 aa                     tax
   418  1248 c921                   cmp #UDG_BUIDLING                   ; is it a building?
   419  124a d024                   bne +
   420  124c a02c                   ldy #SCREEN_WIDTH*2                 ; check 2 lines below
   421  124e b134                   lda (BOMB),y
   422  1250 c924                   cmp #UDG_GRASS                      ; grass below?
   423  1252 d01c                   bne +
   424                          
   425  1254 c626                   dec BUILDINGS_STANDING              ; reduce the count of buildings
   426  1256 e623                   inc BUILDINGS_UNITS                 ; increase count of toppled buildings
   427  1258 a523                   lda BUILDINGS_UNITS                 ; check for rollovers
   428  125a c93a                   cmp #CHAR_10
   429  125c d012                   bne +
   430  125e a930                   lda #CHAR_0                         ; 10, so units to 0 and increment 10s
   431  1260 8523                   sta BUILDINGS_UNITS
   432  1262 e624                   inc BUILDINGS_TENS
   433  1264 a524                   lda BUILDINGS_TENS                  ; check for rollovers
   434  1266 c93a                   cmp #CHAR_10
   435  1268 d006                   bne +
   436  126a a930                   lda #CHAR_0                         ; 100 so tens to 0 and increment 100s
   437  126c 8524                   sta BUILDINGS_TENS
   438  126e e625                   inc BUILDINGS_HUNDREDS              ; no I am not checking for 1000.
   439                          
   440  1270 a000               +   ldy #0                              ; restore order to the universe
   441  1272 e026                   cpx #UDG_ROOF                       ; is there a roof below us?
   442  1274 d005                   bne +
   443  1276 a982                   lda #$82                            ; make the crunching noise
   444  1278 8d0d90                 sta VIC_NOISE_FREQ
   445                          
   446  127b a534               +   lda BOMB_LSB                        ; move bomb down 1 line
   447  127d 18                     clc
   448  127e 6916                   adc #SCREEN_WIDTH
   449  1280 8534                   sta BOMB_LSB
   450  1282 8536                   sta BOMB_COLOUR_LSB
   451  1284 9004                   bcc +
   452  1286 e635                   inc BOMB_MSB
   453  1288 e637                   inc BOMB_COLOUR_MSB
   454                          
   455  128a a535               +   lda BOMB_MSB                        ; check if it is at ground level
   456  128c c91f                   cmp #>GROUND_POS                    ;
   457  128e d004                   bne +                               ; different, so no need to check LSB
   458  1290 a534                   lda BOMB_LSB                        ; compare LSB instead
   459  1292 c9b8                   cmp #<GROUND_POS                    ;
   460  1294 9093               +   bcc bombloop                        ; no, keep moving down
   461                          
   462                              ; bomb landed
   463  1296 a203                   ldx #3                              ; get a random number from 0 to 2
   464  1298 203014                 jsr RND
   465                          
   466  129b 18                     clc                                 ; move plane by that amount
   467  129c 6530                   adc PLANE_LSB
   468  129e 8530                   sta PLANE_LSB
   469  12a0 8532                   sta PLANE_COLOUR_LSB
   470  12a2 9004                   bcc +
   471  12a4 e631                   inc PLANE_MSB
   472  12a6 e633                   inc PLANE_COLOUR_MSB
   473                          +
   474                          
   475  12a8 e621                   inc BOMBS_UNITS                     ; bombs used count++
   476  12aa a521                   lda BOMBS_UNITS                     ; check for rollovers
   477  12ac c93a                   cmp #CHAR_10
   478  12ae d014                   bne +
   479  12b0 a930                   lda #CHAR_0                         ; 10, so units to 0 and increment 10s
   480  12b2 8521                   sta BOMBS_UNITS
   481  12b4 e622                   inc BOMBS_TENS                      ; max is 30, so no rollover to check
   482  12b6 a522                   lda BOMBS_TENS                      ; check bomb count
   483  12b8 c933                   cmp #CHAR_3                         ; max is 30
   484  12ba 9008                   bcc +
   485  12bc a902                   lda #COLOUR_RED                     ; max bombs used, set the display red
   486  12be 8dda97                 sta SCREEN_B_TENS + COLOUR_RAM_OFFSET
   487  12c1 8ddb97                 sta SCREEN_B_UNITS + COLOUR_RAM_OFFSET
   488                          
   489  12c4 a9fe               +   lda #$FE                            ; reset bomb note
   490  12c6 8512                   sta BOMB_NOTE
   491                          
   492  12c8 8c0a90                 sty VIC_OSC1_FREQ                   ; sound off
   493  12cb 8c0d90                 sty VIC_NOISE_FREQ                  ; noise off
   494                          
   495  12ce 60                     rts
   496                          
   497                          ;======================================================================================
   498                          ; Tell the pilot how bad they really are
