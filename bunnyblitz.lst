   501  12cf 209613                 jsr SUB_START_TEXT_SCREEN
   502                          
   503  12d2 a915                   lda #>TEXT_CRASHED
   504  12d4 8539                   sta TEXT_MSB
   505  12d6 a978                   lda #<TEXT_CRASHED
   506  12d8 8538                   sta TEXT_LSB
   507                          
   508  12da a91e                   lda #>SCREEN_RAM_LINE_00
   509  12dc a200                   ldx #<SCREEN_RAM_LINE_00
   510  12de 201614                 jsr SUB_PRINT_STRING
   511                          
   512  12e1 20a913                 jsr SUB_SHOW_STATS
   513                          
   514  12e4 4c0613                 jmp ANOTHER_GO
