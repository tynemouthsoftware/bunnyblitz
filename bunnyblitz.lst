    27                          ;======================================================================================
    28                          ; Zero page Variables
    29                          ;======================================================================================
    30                          ; $00 and $01 get overwritten
    31                          
    32                          TEMP                    = $02
    33                          
    34                          SEED_LSB                = $07
    35                          SEED_MSB                = $08
    36                          SEED                    = SEED_LSB
    37                          
    38                          SKIP_TITLE              = $10
    39                          PLANE_DELAY             = $11
    40                          BOMB_NOTE               = $12
    41                          COL                     = $13
    42                          
    43                          SCORE                   = $20
    44                          
    45                          BOMBS_UNITS             = $21
    46                          BOMBS_TENS              = $22
    47                          
    48                          BUILDINGS_UNITS         = $23
    49                          BUILDINGS_TENS          = $24
    50                          BUILDINGS_HUNDREDS      = $25
    51                          
    52                          BUILDINGS_STANDING      = $26
    53                          
    54                          ;--------------------------------------------------------------------------------------
    55                          ; 16 bit Variables
