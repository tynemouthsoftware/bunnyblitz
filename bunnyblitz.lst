   545                              ; another go?
   546  1306 a914                   lda #>TEXT_ANOTHER_GO
   547  1308 8539                   sta TEXT_MSB
   548  130a a9d2                   lda #<TEXT_ANOTHER_GO
   549  130c 8538                   sta TEXT_LSB
   550                          
   551  130e a91f                   lda #>SCREEN_RAM_LINE_20 + 2
   552  1310 a2ba                   ldx #<SCREEN_RAM_LINE_20 + 2
   553  1312 201614                 jsr SUB_PRINT_STRING
   554                          
   555  1315 a5c5               -   lda LAST_KEY                        ; wait for key press
   556  1317 c940                   cmp #KEY_NONE
   557  1319 f0fa                   beq -
   558                          
   559  131b c90b                   cmp #KEY_Y                          ; was it Y ?
   560  131d f007                   beq RESTART
   561                          
   562  131f c91c                   cmp #KEY_N                          ; was it N?
   563  1321 d0f2                   bne -                               ; no, keep checking
   564                          
   565  1323 4c22fd                 jmp KERNAL_START                    ; N = reset VIC to READY prompt
   566                          
   567                          RESTART:
   568  1326 4c3c10                 jmp start                           ; Y = start again
   569                          
   570                          
   571                          ;======================================================================================
