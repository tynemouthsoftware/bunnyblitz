   576  132c 8c0a90                 sty VIC_OSC1_FREQ                   ;
   577                          
   578  132f a5c5               -   lda LAST_KEY                        ; wait for key release
   579  1331 c940                   cmp #KEY_NONE
   580  1333 d0fa                   bne -
   581                          
   582  1335 a5c5               -   lda LAST_KEY                        ; wait for key press
   583  1337 c940                   cmp #KEY_NONE
   584  1339 f0fa                   beq -
   585                          
   586  133b a5c5               -   lda LAST_KEY                        ; wait for key release
   587  133d c940                   cmp #KEY_NONE
   588  133f d0fa                   bne -
   589                          
   590  1341 a9f5                   lda #$F5                            ; make the noise
   591  1343 8c0d90                 sty VIC_NOISE_FREQ
   592                          
   593  1346 60                     rts
