    57                          
    58                          PLANE                   = $30
    59                          PLANE_LSB               = PLANE
    60                          PLANE_MSB               = PLANE + 1
    61                          
    62                          PLANE_COLOUR            = $32
    63                          PLANE_COLOUR_LSB        = PLANE_COLOUR
    64                          PLANE_COLOUR_MSB        = PLANE_COLOUR + 1
    65                          
    66                          BOMB                    = $34
    67                          BOMB_LSB                = BOMB
    68                          BOMB_MSB                = BOMB + 1
    69                          
    70                          BOMB_COLOUR             = $36
    71                          BOMB_COLOUR_LSB         = BOMB_COLOUR
    72                          BOMB_COLOUR_MSB         = BOMB_COLOUR + 1
    73                          
    74                          TEXT                    = $38
    75                          TEXT_LSB                = TEXT
    76                          TEXT_MSB                = TEXT+1
    77                          
    78                          TEXT_POS                = $3A
    79                          TEXT_POS_LSB            = TEXT_POS
